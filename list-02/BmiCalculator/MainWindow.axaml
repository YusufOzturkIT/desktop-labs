<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BmiCalculator.MainWindow"
        Title="BMI Calculator" Width="450" Height="500"
        MinWidth="400" MinHeight="450">

    <DockPanel>
        <!-- Menu (Top) -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Register..." Click="OnRegisterMenuClick"/>
                <Separator/>
                <MenuItem Header="_Exit" Click="OnExitMenuClick"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="OnAboutMenuClick"/>
            </MenuItem>
        </Menu>

        <!-- Status Bar (Bottom) -->
        <Border DockPanel.Dock="Bottom" BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="5">
            <TextBlock x:Name="StatusText" Text="Ready"/>
        </Border>

        <!-- Main Content Form (Center) -->
        <ScrollViewer>
            <StackPanel Margin="15" Spacing="10">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="100,*,80">
                    <!-- Weight Row -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Weight:" VerticalAlignment="Center"/>
                    <TextBox x:Name="WeightBox" Grid.Row="0" Grid.Column="1" Margin="5"/>
                    <ComboBox x:Name="WeightUnitBox" Grid.Row="0" Grid.Column="2" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="kg"/>
                        <ComboBoxItem Content="lb"/>
                    </ComboBox>

                    <!-- Height Row -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Height:" VerticalAlignment="Center"/>
                    <TextBox x:Name="HeightBox" Grid.Row="1" Grid.Column="1" Margin="5"/>
                    <ComboBox x:Name="HeightUnitBox" Grid.Row="1" Grid.Column="2" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="cm"/>
                        <ComboBoxItem Content="in"/>
                    </ComboBox>
                </Grid>

                <CheckBox x:Name="DescCheckBox" Content="Show category description" IsChecked="True" IsCheckedChanged="OnDescCheckedChanged"/>

                <Button Content="Calculate" Click="OnCalculateClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                <!-- Result Area -->
                <TextBlock x:Name="ResultText" FontSize="16" FontWeight="Bold" Margin="0,5,0,0"/>
                <TextBlock x:Name="DescText" Text="(A healthy range is 18.5 - 24.9)" Foreground="Gray" IsVisible="True"/>

                <Separator Margin="0,10"/>

                <!-- Task 3: History ListBox -->
                <TextBlock Text="History (Last 5):" FontWeight="SemiBold"/>
                <ListBox x:Name="HistoryListBox" Height="120"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>