<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Contacts.ViewModels"
        xmlns:m="using:Contacts.Models"
        x:Class="Contacts.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Contact Book" Width="700" Height="500"
        MinWidth="600" MinHeight="400">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock.header">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,6"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#DC3545"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,6"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Opacity="0.8"/>
        </Border>

        <Grid ColumnDefinitions="300,*">
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto" Margin="10">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBox Grid.Column="0" Text="{Binding SearchText}" Watermark="Search..." Margin="0,0,5,0"/>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsDarkMode}" OffContent="Light" OnContent="Dark"/>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5" Margin="0,0,0,8">
                    <TextBlock Text="Sort by:" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <Panel Grid.Row="2">
                    <ListBox ItemsSource="{Binding FilteredContacts}" SelectedItem="{Binding SelectedContact}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="m:Contact">
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="⭐" IsVisible="{Binding IsFavorite}"/>
                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Phone}" Opacity="0.7" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{Binding EmptyStateMessage}" 
                               IsVisible="{Binding ShowEmptyState}" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Foreground="Gray" Margin="10"/>
                </Panel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                    <Button Classes="primary" Content="Add" Command="{Binding AddCommand}"/>
                    <Button Classes="danger" Content="Delete" Command="{Binding DeleteCommand}"/>
                </StackPanel>
            </Grid>

            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1,0,0,0" Padding="15">
                <Panel>
                    <TextBlock Text="Select a contact" 
                               IsVisible="{Binding !HasSelection}" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" 
                               FontSize="16" Foreground="Gray"/>

                    <StackPanel IsVisible="{Binding HasSelection}" Spacing="10">
                        <TextBlock Classes="header" Text="Contact Details"/>

                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="90,*">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="First name:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedContact.FirstName}" Margin="0,4"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Last name:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedContact.LastName}" Margin="0,4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Phone:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedContact.Phone}" Margin="0,4"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="E-mail:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedContact.Email}" Margin="0,4"/>

                            <CheckBox Grid.Row="4" Grid.Column="1" Content="Favorite" IsChecked="{Binding SelectedContact.IsFavorite}" Margin="0,4"/>
                        </Grid>
                    </StackPanel>
                </Panel>
            </Border>
        </Grid>
    </DockPanel>
</Window>