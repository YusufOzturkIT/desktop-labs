<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaCounter.ViewModels"
        x:Class="AvaloniaCounter.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Hello World Counter" Width="300" Height="200">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15">
        <TextBlock Text="{Binding Count, StringFormat='Count: {0}'}" 
                   FontSize="24" HorizontalAlignment="Center" FontWeight="Bold"/>
        
        <Button Content="Click Me!" Command="{Binding IncrementCommand}" 
                HorizontalAlignment="Center" Padding="15,8"/>
    </StackPanel>
</Window>
