<Window x:Class="WpfCounter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF Counter" Height="200" Width="300" WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15" Margin="20">
            <TextBlock x:Name="CountText" Text="Count: 0" FontSize="24" HorizontalAlignment="Center" FontWeight="Bold"/>
            <Button Content="Click Me!" Click="Button_Click" Padding="15,8" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
