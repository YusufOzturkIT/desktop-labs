<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PersonalBudgetManager.ViewModels"
             x:Class="PersonalBudgetManager.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <StackPanel Spacing="20" Margin="20">
        <TextBlock Text="📊 Financial Overview" FontSize="22" FontWeight="Bold"/>

        <Grid ColumnDefinitions="*,*,*" Margin="0,10">
            <Border Grid.Column="0" Background="#1E3A8A" CornerRadius="8" Padding="15" Margin="5">
                <StackPanel Spacing="5">
                    <TextBlock Text="Total Income" Foreground="White" FontSize="14"/>
                    <TextBlock Text="{Binding TotalIncome, StringFormat='${0:N2}'}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#991B1B" CornerRadius="8" Padding="15" Margin="5">
                <StackPanel Spacing="5">
                    <TextBlock Text="Total Expenses" Foreground="White" FontSize="14"/>
                    <TextBlock Text="{Binding TotalExpenses, StringFormat='${0:N2}'}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#065F46" CornerRadius="8" Padding="15" Margin="5">
                <StackPanel Spacing="5">
                    <TextBlock Text="Net Savings" Foreground="White" FontSize="14"/>
                    <TextBlock Text="{Binding NetSavings, StringFormat='${0:N2}'}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
