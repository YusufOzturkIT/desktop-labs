<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PersonalBudgetManager.ViewModels"
             x:Class="PersonalBudgetManager.Views.DataLogView"
             x:DataType="vm:DataLogViewModel">
    <StackPanel Spacing="15" Margin="20">
        <TextBlock Text="📁 File Operations & Logs" FontSize="20" FontWeight="Bold"/>

        <Border Background="#1E1E1E" CornerRadius="6" Padding="15">
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding WatcherStatus}" Foreground="#4EC9B0" FontWeight="SemiBold"/>
                
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Import CSV Statement" Command="{Binding SimulateCsvImportCommand}" Padding="10,5"/>
                    <Button Content="Export to CSV" Command="{Binding ExportDataCommand}" Padding="10,5"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="Activity History Logs:" FontWeight="Bold" Margin="0,10,0,0"/>
        <ListBox ItemsSource="{Binding Logs}" Height="200"/>
    </StackPanel>
</UserControl>
