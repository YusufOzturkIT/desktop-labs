<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PersonalBudgetManager.ViewModels"
             x:Class="PersonalBudgetManager.Views.DataLogView"
             x:DataType="vm:DataLogViewModel">
    <StackPanel Spacing="10" Margin="20">
        <TextBlock Text="📁 Data Logs &amp; Directory Watcher" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="{Binding Message}" FontSize="14" Foreground="Gray"/>
    </StackPanel>
</UserControl>
